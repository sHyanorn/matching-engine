+}
+
+func (b *Book) node(ord Order) *orderNode {
+	o := b.free
+	if o == nil {
+		return &orderNode{Order: ord}
+	}
+	b.free = o.next
+	*o = orderNode{Order: ord}
+	return o
+}
+
+func (b *Book) release(o *orderNode) {
+	*o = orderNode{next: b.free}
+	b.free = o
 }
